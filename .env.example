# ==============================================================================
# Environment Configuration Template for Sales ETL Pipeline
# ==============================================================================

# Database Target URL (Default: SQLite local database)
# To target PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/sales_db
DB_CONNECTION_URL="sqlite:///data/processed/sales.db"

# Data File Paths
RAW_SALES_PATH="data/raw/sales_data.csv"
REPORTS_OUTPUT_DIR="reports"
LOG_FILE_PATH="pipeline.log"

# Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL="INFO"
